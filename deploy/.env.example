# Copy to deploy/.env and protect with chmod 600. Never commit real secrets.
# Use a URL-safe password: it is used in both PostgreSQL and DATABASE_URL.
POSTGRES_USER=ocstudio
POSTGRES_DB=ocstudio
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD
APP_ORIGIN=https://studio.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
IMAGE_TAG=dev
HTTP_PORT=3000

# Generate with: openssl rand -hex 32 (leave blank only if periodic backups are disabled).
BACKUP_WORKER_TOKEN=

# Scheduled archives live in deploy/data/scheduled-backups (UID 10001).
