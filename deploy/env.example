# Copy this file to deploy/.env. Choose a real domain with DNS records
# pointing to the VPS and open TCP ports 80/443.
DOMAIN=oc.example.com
BETTER_AUTH_URL=https://oc.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
# Keep this password URL-safe, or percent-encode it in DATABASE_URL.
DB_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_DATABASE_PASSWORD
DATABASE_URL=postgresql://ocstudio:REPLACE_WITH_RANDOM_URL_SAFE_DATABASE_PASSWORD@db:5432/ocstudio
