# Copy to project root .env.local. Replace credentials before startup.
DATABASE_URL=postgresql://ocstudio:CHANGE_ME@127.0.0.1:5432/ocstudio
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS_NEVER_COMMIT_SECRETS
# Absolute directory, outside public/ and /var/www/, readable by the Node app.
MEDIA_ROOT=/var/lib/ocstudio/media
